{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "familiar-bakeoff-tauri",
  "version": "0.0.0",
  "identifier": "dev.familiar.bakeoff",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Familiar (Tauri)", "width": 1280, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
