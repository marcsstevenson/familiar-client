{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git:*)", "Bash(gh:*)", "Bash(cargo:*)", "Bash(rustup:*)",
      "Bash(bash scripts/*)", "Bash(curl:*)", "Bash(python3:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(sed:*)",
      "Bash(find:*)", "Bash(mkdir:*)", "Bash(timeout:*)",
      "Bash(cd:*)", "Bash(env:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(sort:*)", "Bash(uniq:*)", "Bash(chmod:*)", "Bash(printf:*)", "Bash(echo:*)",
      "Bash(rg:*)", "Bash(diff:*)", "Bash(jq:*)", "Bash(cut:*)", "Bash(tr:*)", "Bash(awk:*)",
      "Bash(pwd)", "Bash(which:*)", "Bash(stat:*)", "Bash(file:*)", "Bash(du:*)",
      "Bash(tree:*)", "Bash(test:*)", "Bash(sqlite3 -readonly:*)",
      "mcp__github__*", "mcp__claude-code-remote__subscribe_pr_activity",
      "PowerShell(git:*)", "PowerShell(cargo:*)",
      "PowerShell(target\\release\\fam.exe:*)", "PowerShell(target\\release\\famd.exe:*)",
      "PowerShell(.\\target\\release\\fam.exe:*)",
      "PowerShell(pwsh -File scripts/cal-check.ps1:*)", "PowerShell(pwsh -File scripts\\cal-check.ps1:*)",
      "PowerShell(Get-Process:*)", "PowerShell(Stop-Process -Name famd:*)",
      "PowerShell(Start-Process -FilePath target\\release\\famd.exe:*)",
      "PowerShell(Get-Content:*)", "PowerShell(Select-String:*)", "PowerShell(Get-ChildItem:*)",
      "PowerShell(tzutil /g)",
      "WebSearch"
    ]
  }
}
